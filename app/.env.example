# Copy to app/.env.local and fill in. Never commit the real file.

# Auth0 "Single Page Application" settings.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.eyespy.local

# Backend URL as seen from the iPad (use the laptop's LAN IP, not localhost, when testing on the iPad).
VITE_API_BASE_URL=http://localhost:8000

# LOCAL DEMOS ONLY: set to e.g. auth0|demo-patient to skip Auth0 (backend needs DEV_AUTH_BYPASS=true).
VITE_DEV_BYPASS_SUB=
