# Copy to backend/.env and fill in. Never commit the real .env.

# Auth0: the API (resource server) you created for Eye Spy.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.eyespy.local
# Custom claim an Auth0 Action adds to access tokens (see BUILD_LOG.md).
AUTH0_ROLES_CLAIM=https://eyespy.app/roles

# Tiger Data (Tiger Cloud) connection string.
DATABASE_URL=postgres://tsdbadmin:password@host:port/tsdb?sslmode=require

# Google AI Studio key. Leave empty to use the built-in fallback lines and the iPad's on-device voice.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Sulafat

# Shared secret the demo dock sends in X-Device-Token. The seed script registers it.
DEVICE_TOKEN=change-me-to-a-long-random-string

# Seed script: Auth0 user ids ("sub") of the demo patient and provider.
DEMO_PATIENT_SUB=auth0|demo-patient
DEMO_PROVIDER_SUB=auth0|demo-provider

# Origins of the React app allowed by CORS (comma-separated). Add your LAN URL for the iPad.
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.20:5173

# LOCAL DEMOS ONLY. When true, "Authorization: Bearer dev:<sub>" is accepted without Auth0.
DEV_AUTH_BYPASS=false
